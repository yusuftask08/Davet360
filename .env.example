# apps/api
# Local dev portları: web 3600, panel 3601, api 4600 — yaygın 3000/3001/4000 yerine, bu
# makinede paralel çalışan diğer projelerle çakışmasın diye özel seçildi.
NODE_ENV=development
PORT=4600
MONGO_URI=mongodb://localhost:27017/pazaryeri
JWT_SECRET=change-me-super-secret
JWT_EXPIRES_IN_DAYS=15
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:3600,http://localhost:3601
ALTCHA_SECRET=change-me-altcha-secret
WEB_URL=http://localhost:3600
PANEL_URL=http://localhost:3601

# Şifre sıfırlama emaili — boş bırakılırsa link konsola loglanır (local dev'de SMTP şart değil)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Davet360 <no-reply@davet360.com>

# İletişim formu mesajlarının gönderileceği adres — boş bırakılırsa mesaj konsola loglanır
CONTACT_EMAIL=

# apps/web ve apps/panel (her ikisine de kopyalanır)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# apps/web — panel'e ("İşletmeni Ekle" CTA'sı, vendor kaydı) çapraz link için
NEXT_PUBLIC_PANEL_URL=http://localhost:3001

# apps/web — opsiyonel self-hosted analytics (Umami). Boş bırakılırsa script hiç eklenmez.
NEXT_PUBLIC_UMAMI_URL=http://localhost:3002
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Yedekleme script'i (scripts/backup.sh)
BACKUP_DIR=./backups
